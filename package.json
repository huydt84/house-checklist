{
  "name": "house-checklist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "LOCAL_AUTH=true node scripts/dev.mjs",
    "dev:admin": "pnpm run dev:local",
    "dev:cleanup": "node scripts/dev-process-cleanup.mjs",
    "build": "next build && node scripts/service-worker.mjs",
    "assets:brand": "node scripts/brand-assets.mjs",
    "start": "next start -H 127.0.0.1 -p 3001",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:db": "LOCAL_AUTH=true node --test --test-concurrency=1 tests/db/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "pnpm run lint && pnpm run test:unit && pnpm run test:db && pnpm run test:e2e",
    "test:quick": "pnpm run lint && pnpm run test:unit",
    "test:full": "pnpm test",
    "test:browser:smoke": "playwright test --grep 'quick creation|checklist states|OAuth callback'",
    "test:visual": "node scripts/visual-review.mjs",
    "test:permissions": "LOCAL_AUTH=true node --test --test-concurrency=1 --test-name-pattern='viewer writes|invitations enforce|revocation is ordered' tests/db/*.test.mjs && playwright test --grep 'private uploads'",
    "test:permissions:repeat": "pnpm run test:permissions && pnpm run test:permissions",
    "db:up:local": "node scripts/docker-local.mjs up",
    "db:down:local": "node scripts/docker-local.mjs down",
    "db:migrate:local": "LOCAL_AUTH=true node scripts/migrate.mjs",
    "db:seed:local": "LOCAL_AUTH=true node scripts/seed.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:migration:new": "node scripts/create-migration.mjs",
    "vercel:env": "node scripts/configure-vercel.mjs",
    "deploy:prod": "pnpm run vercel:env && pnpm run db:migrate && pnpm exec vercel --prod --yes",
    "format": "prettier --write components lib app scripts tests *.mjs auth.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-select": "2.3.7",
    "@vercel/blob": "^2.3.0",
    "ajv": "8.20.0",
    "decimal.js": "^10.6.0",
    "dexie": "^4.0.0",
    "luxon": "3.7.2",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "pdfmake": "0.3.11",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.8.1",
    "vercel": "58.4.4",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-sw": "7.4.1"
  }
}
